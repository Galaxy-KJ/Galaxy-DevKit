{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@galaxy-kj/core-stellar-sdk": ["packages/core/stellar-sdk/dist/stellar-sdk/src/index.d.ts"],
      "@galaxy-kj/core-stellar-sdk/*": ["packages/core/stellar-sdk/dist/stellar-sdk/src/*"],
      "@galaxy-kj/core-wallet": ["packages/core/wallet/dist/src/index.d.ts"],
      "@galaxy-kj/core-wallet/*": ["packages/core/wallet/dist/src/*"]
    },
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "types": ["node", "express", "jest"],
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts", "src/__tests__/**/*"]
}
