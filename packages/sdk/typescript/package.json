{
  "name": "@galaxy-kj/sdk-typescript",
  "version": "5.0.0",
  "description": "Typed browser and Node client for the available Galaxy REST API",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "scripts": {
    "build": "node scripts/build.cjs",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/smoke.cjs"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.6.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "keywords": [
    "stellar",
    "sdk",
    "typescript",
    "galaxy",
    "defi"
  ],
  "author": "Galaxy DevKit Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Galaxy-KJ/Galaxy-DevKit.git",
    "directory": "packages/sdk/typescript"
  },
  "private": true,
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./stellar/*": {
      "import": {
        "types": "./dist/esm/stellar/*.d.ts",
        "default": "./dist/esm/stellar/*.js"
      },
      "require": {
        "types": "./dist/cjs/stellar/*.d.ts",
        "default": "./dist/cjs/stellar/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}
