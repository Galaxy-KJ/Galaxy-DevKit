{
  "name": "@galaxy-kj/frontend",
  "version": "1.0.0",
  "description": "Vite playground for Galaxy DevKit smart wallets, Stellar SDK flows, and browser integration testing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "test": "jest --config jest.config.cjs",
    "test:coverage": "jest --coverage --config jest.config.cjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@galaxy-kj/core-defi-protocols": "^5.0.0",
    "@galaxy-kj/core-oracles": "^5.0.0",
    "@galaxy-kj/core-stellar-sdk": "^5.0.0",
    "@galaxy-kj/core-wallet": "^5.0.0",
    "@stellar/stellar-sdk": "^14.4.3",
    "bignumber.js": "^9.1.2",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "buffer": "^6.0.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "vite": "^6.4.3"
  }
}
