{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@galaxy-kj/core-stellar-sdk": ["packages/core/stellar-sdk/dist/stellar-sdk/src/index.d.ts"],
      "@galaxy-kj/core-stellar-sdk/*": ["packages/core/stellar-sdk/dist/stellar-sdk/src/*"]
    },
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false
  },
  "include": [
    "index.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "examples",
    "../stellar-sdk/**/*"
  ]
}
