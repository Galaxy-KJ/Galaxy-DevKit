{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@galaxy-kj/core/*": [
        "packages/core/*/src"
      ],
      "@galaxy-kj/core-stellar-sdk": [
        "packages/core/stellar-sdk/src/index.ts"
      ],
      "@galaxy-kj/core-stellar-sdk/*": [
        "packages/core/stellar-sdk/src/*"
      ],
      "@galaxy-kj/core-wallet": [
        "packages/core/wallet/src/index.ts"
      ],
      "@galaxy-kj/core-wallet/*": [
        "packages/core/wallet/src/*"
      ],
      "@galaxy-kj/core-defi-protocols": [
        "packages/core/defi-protocols/src"
      ],
      "@galaxy-kj/core-defi-protocols/*": [
        "packages/core/defi-protocols/src/*"
      ],
      "@galaxy-kj/core-oracles": [
        "packages/core/oracles/src"
      ],
      "@galaxy-kj/core-oracles/*": [
        "packages/core/oracles/src/*"
      ],
      "@galaxy-kj/core-test-utils": [
        "packages/core/test-utils/src"
      ],
      "@galaxy-kj/core-test-utils/*": [
        "packages/core/test-utils/src/*"
      ],
      "@galaxy-kj/core-invisible-wallet": [
        "packages/core/invisible-wallet/src"
      ],
      "@galaxy-kj/core-invisible-wallet/*": [
        "packages/core/invisible-wallet/src/*"
      ],
      "@galaxy-kj/core-automation": [
        "packages/core/automation/src"
      ],
      "@galaxy-kj/core-automation/*": [
        "packages/core/automation/src/*"
      ],
      "@galaxy-kj/frontend": [
        "packages/frontend/src"
      ],
      "@galaxy-kj/frontend/*": [
        "packages/frontend/src/*"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "tools/*/src/**/*",
    "**/*.ts",
    "**/*.tsx",
    "packages/core/invisible-wallet/src/services/invisible-wallet.service.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
